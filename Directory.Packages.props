<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <HttpServerVersion>3.2.0</HttpServerVersion>
        <ShinyVersion>7.2.0</ShinyVersion>
        <!-- pinned rather than taken from the installed MAUI workload, so the AppKit backend (Microsoft.Maui.Platforms.MacOS) matches it -->
        <MauiVersion>11.0.10</MauiVersion>
        <MauiLabsVersion>0.1.0-preview.16.26575.3</MauiLabsVersion>
        <MsftExtensionVersion>11.0.0</MsftExtensionVersion>
        <ActorsVersion>1.0.0-beta.12</ActorsVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Shiny.Net.HttpServer" Version="$(HttpServerVersion)"/>
        <PackageVersion Include="Shiny.Net.HttpServer.Discovery" Version="$(HttpServerVersion)"/>
        <PackageVersion Include="Shiny.Net.HttpServer.Testing" Version="$(HttpServerVersion)"/>
        <PackageVersion Include="Shiny.Core" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.BluetoothLE" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.BluetoothLE.Hosting" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Xamarin.GooglePlayServices.Nearby" Version="119.5.0"/>
        <PackageVersion Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.1"/>
        <PackageVersion Include="Shiny.Hosting.Maui" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Maui.Shell" Version="8.0.1"/>
        <PackageVersion Include="Shiny.Maui.Controls" Version="3.0.0"/>
        <!-- the sample's calls: IAudioDuplex (Shiny.Audio) and VideoEncoder / RemoteVideoView (camera) -->
        <PackageVersion Include="Shiny.Maui.Controls.Camera" Version="3.0.0"/>
        <PackageVersion Include="Shiny.Audio" Version="3.0.0"/>
        <PackageVersion Include="Shiny.Actors" Version="$(ActorsVersion)"/>
        <PackageVersion Include="Shiny.Notifications" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Net.HttpServer.Ssh" Version="$(HttpServerVersion)"/>
    </ItemGroup>
    <ItemGroup>
        <!-- the core: the argument codec, and the source generator -->
        <PackageVersion Include="Shiny.Extensions.Serialization" Version="6.0.2"/>
        <PackageVersion Include="System.Reactive" Version="7.0.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="$(MsftExtensionVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0"/>
        <PackageVersion Include="xunit.v3" Version="4.0.3"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1"/>
    </ItemGroup>
</Project>
