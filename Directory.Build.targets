<Project>
    <ItemGroup>
        <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Condition="'$(IsPackable)' != 'false'">
        <None Include="$(MSBuildThisFileDirectory)nuget.png" Pack="true" PackagePath="icon.png" Visible="false" />
        <!-- the Shiny.BluetoothLE.Hubs packages set PackageReadmeSource to their own readme -->
        <None Include="$(MSBuildThisFileDirectory)$(PackageReadmeSource)" Pack="true" PackagePath="README.md" Visible="false" />
    </ItemGroup>

    <!-- NBGV always appends +<commit> to the informational version; strip it (see PublicRelease in Directory.Build.props) -->
    <Target Name="StripCommitFromInformationalVersion" AfterTargets="GetBuildVersion">
        <PropertyGroup>
            <AssemblyInformationalVersion>$(AssemblyInformationalVersion.Split('+')[0])</AssemblyInformationalVersion>
        </PropertyGroup>
    </Target>
</Project>
