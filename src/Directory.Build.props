<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <!-- Shiny.BluetoothLE.Hubs: its own product name and tags, next to the UniversalHubs packages (every package shares README.md) -->
    <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Shiny.BluetoothLE.Hubs'))">
        <Product>Shiny.BluetoothLE.Hubs</Product>
        <PackageTags>ble bluetooth bluetoothle hub signalr gatt l2cap ios android maui</PackageTags>
    </PropertyGroup>
</Project>
