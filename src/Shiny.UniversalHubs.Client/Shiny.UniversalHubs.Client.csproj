<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(PlatformTargetFrameworks)</TargetFrameworks>
        <IsAotCompatible>true</IsAotCompatible>
        <RootNamespace>Shiny.UniversalHubs</RootNamespace>
        <Description>Shiny.UniversalHubs client - finds hub hosts over Bluetooth LE and mDNS and connects to them over whichever is available, behind the same generated proxy</Description>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\Shiny.UniversalHubs\Shiny.UniversalHubs.csproj" />
        <PackageReference Include="Shiny.BluetoothLE" />
        <ProjectReference Include="..\Shiny.BluetoothLE.Hubs.Client\Shiny.BluetoothLE.Hubs.Client.csproj" />
        <PackageReference Include="Shiny.Net.HttpServer.Switchboard.Client" />
        <PackageReference Include="Shiny.Net.HttpServer.Discovery" />
        <InternalsVisibleTo Include="Shiny.UniversalHubs.Tests" />
        <!-- the add-on Multipeer transport plugs into the internal transport seams -->
        <InternalsVisibleTo Include="Shiny.UniversalHubs.Multipeer" />
    </ItemGroup>
</Project>
