<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <RootNamespace>Shiny.UniversalHubs</RootNamespace>
        <Description>Shiny.UniversalHubs - SignalR style hubs over any transport: hubs, hosts, clients, the transport seams, the wire protocols and the hub source generator</Description>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Shiny.Extensions.Serialization" />
        <PackageReference Include="System.Reactive" />
        <InternalsVisibleTo Include="Shiny.UniversalHubs.BluetoothLE" />
        <InternalsVisibleTo Include="Shiny.UniversalHubs.Http" />
        <InternalsVisibleTo Include="Shiny.UniversalHubs.Multipeer" />
        <InternalsVisibleTo Include="Shiny.UniversalHubs.Nearby" />
        <InternalsVisibleTo Include="Shiny.UniversalHubs.Tests" />
        <InternalsVisibleTo Include="Shiny.UniversalHubs.BluetoothLE.Tests" />
    </ItemGroup>
    <ItemGroup>
        <!-- ship the generator with the package so host and client apps both get it -->
        <ProjectReference Include="..\Shiny.UniversalHubs.SourceGenerators\Shiny.UniversalHubs.SourceGenerators.csproj" ReferenceOutputAssembly="false" OutputItemType="None" PrivateAssets="all" />
        <None Include="..\Shiny.UniversalHubs.SourceGenerators\bin\$(Configuration)\netstandard2.0\Shiny.UniversalHubs.SourceGenerators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>

</Project>
