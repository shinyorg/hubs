<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <RootNamespace>TicTacToe</RootNamespace>
        <UseMaui>true</UseMaui>
        <IsPackable>false</IsPackable>
        <SingleProject>true</SingleProject>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <ApplicationTitle>SwitchboardR TicTacToe</ApplicationTitle>
        <ApplicationId>org.shiny.switchboardr.tictactoe</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <!-- L2CAP file transfers (avatars) need API 29 - the game itself still works below that -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
        <MauiImage Include="Resources\Images\*" />
        <MauiFont Include="Resources\Fonts\*" />
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Shiny.Hosting.Maui" />
        <PackageReference Include="Shiny.Maui.Shell" />
        <PackageReference Include="Shiny.BluetoothLE" />
        <PackageReference Include="Shiny.BluetoothLE.Hosting" />
    </ItemGroup>

    <ItemGroup>
        <!-- Shiny.BluetoothLE.Hubs comes from NuGet through these, generator included -->
        <ProjectReference Include="..\..\src\Shiny.SwitchboardR.Host\Shiny.SwitchboardR.Host.csproj" />
        <ProjectReference Include="..\..\src\Shiny.SwitchboardR.Client\Shiny.SwitchboardR.Client.csproj" />
    </ItemGroup>

</Project>
