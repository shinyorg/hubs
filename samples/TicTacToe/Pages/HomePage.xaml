<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TicTacToe.Pages"
             x:Class="TicTacToe.Pages.HomePage"
             x:DataType="local:HomeViewModel"
             Title="Tic Tac Toe">

    <Grid RowDefinitions="*,Auto" Padding="24">
        <VerticalStackLayout Spacing="20" VerticalOptions="Center">

            <Label Text="Tic Tac Toe"
                   FontSize="36"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Two phones, one hub - over Bluetooth on a plane, over Wi-Fi at home. Moves are hub calls, board updates are hub pushes, avatars are files."
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

            <Border WidthRequest="120"
                    HeightRequest="120"
                    StrokeShape="RoundRectangle 60"
                    HorizontalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                <Grid>
                    <Label Text="📷"
                           FontSize="40"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Image Source="{Binding Avatar}" Aspect="AspectFill" />
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PickAvatarCommand}" />
                </Border.GestureRecognizers>
            </Border>

            <Button Text="Remove avatar"
                    Command="{Binding ClearAvatarCommand}"
                    Style="{StaticResource LinkButton}"
                    IsVisible="{Binding Avatar, Converter={StaticResource IsNotNullConverter}}" />

            <Entry Text="{Binding PlayerName}"
                   Placeholder="Player name"
                   MaxLength="12"
                   HorizontalTextAlignment="Center" />

            <Button Text="Host a game"
                    Command="{Binding HostCommand}" />

            <Button Text="Join a game"
                    Command="{Binding JoinCommand}"
                    Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>

        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}" />
    </Grid>
</ContentPage>
