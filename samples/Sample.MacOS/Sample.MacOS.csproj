<Project Sdk="Microsoft.NET.Sdk">

    <!--
        A macOS (AppKit) host and client for the Universal Hubs sample, on .NET MAUI's AppKit backend from dotnet/maui-labs.
        Like the phone app it hosts its chat and games over BLE and Wi-Fi, and joins anyone else's. It is the phone app:
        the XAML app, shell, pages, hubs, game and services are all linked - only startup is its own.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0-macos</TargetFramework>
        <OutputType>Exe</OutputType>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <IsPackable>false</IsPackable>
        <RootNamespace>Sample.MacOS</RootNamespace>
        <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <ApplicationTitle>Universal Hubs</ApplicationTitle>
        <ApplicationId>org.shiny.universalhubs.sample.macos</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>
    </PropertyGroup>

    <ItemGroup>
        <MauiXaml Include="..\Sample\App.xaml" Link="App.xaml" />
        <MauiXaml Include="..\Sample\AppShell.xaml" Link="AppShell.xaml" />
        <MauiXaml Include="..\Sample\Pages\*.xaml" Link="Pages\%(Filename)%(Extension)" />
        <MauiXaml Include="..\Sample\Resources\Styles\*.xaml" Link="Resources\Styles\%(Filename)%(Extension)" />
        <Compile Include="..\Sample\App.xaml.cs" Link="App.xaml.cs" />
        <Compile Include="..\Sample\AppShell.xaml.cs" Link="AppShell.xaml.cs" />
        <Compile Include="..\Sample\Pages\*.cs" Link="Pages\%(Filename)%(Extension)" />
        <Compile Include="..\Sample\Hub\*.cs" Link="Shared\Hub\%(Filename)%(Extension)" />
        <Compile Include="..\Sample\Game\*.cs" Link="Shared\Game\%(Filename)%(Extension)" />
        <Compile Include="..\Sample\Services\*.cs" Link="Shared\Services\%(Filename)%(Extension)" />
        <Compile Include="..\Sample\Calls\*.cs" Link="Shared\Calls\%(Filename)%(Extension)" />
        <MauiIcon Include="..\Sample\Resources\AppIcon\appicon.png" ForegroundFile="..\Sample\Resources\AppIcon\appiconfg.png" />
        <MauiFont Include="..\Sample\Resources\Fonts\*" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.Maui.Platforms.MacOS" />
        <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" />
        <PackageReference Include="Shiny.Maui.Controls" />
        <PackageReference Include="Shiny.Maui.Controls.Camera" />
        <PackageReference Include="Shiny.Audio" />
        <PackageReference Include="Shiny.Maui.Shell" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <!-- Shiny's macOS builds: the BLE stacks and notifications that blehubs only registers itself on phones -->
        <PackageReference Include="Shiny.Hosting.Maui" />
        <PackageReference Include="Shiny.BluetoothLE" />
        <PackageReference Include="Shiny.BluetoothLE.Hosting" />
        <PackageReference Include="Shiny.Notifications" />
        <PackageReference Include="Shiny.Actors" />
        <PackageReference Include="Shiny.Net.HttpServer.Ssh" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.UniversalHubs.Host\Shiny.UniversalHubs.Host.csproj" />
        <ProjectReference Include="..\..\src\Shiny.UniversalHubs.Client\Shiny.UniversalHubs.Client.csproj" />
        <ProjectReference Include="..\..\src\Shiny.UniversalHubs.Multipeer\Shiny.UniversalHubs.Multipeer.csproj" />
        <!-- the hub proxies and dispatchers: a project reference doesn't carry the generator the way the package does -->
        <ProjectReference Include="..\..\src\Shiny.BluetoothLE.Hubs.SourceGenerators\Shiny.BluetoothLE.Hubs.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
</Project>
