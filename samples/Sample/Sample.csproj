<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <RootNamespace>Sample</RootNamespace>
        <UseMaui>true</UseMaui>
        <IsPackable>false</IsPackable>
        <SingleProject>true</SingleProject>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <ApplicationTitle>Universal Hubs</ApplicationTitle>
        <ApplicationId>org.shiny.universalhubs.sample</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <!-- L2CAP file transfers (avatars) need API 29 - the game itself still works below that -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.png" ForegroundFile="Resources\AppIcon\appiconfg.png" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2F2658" BaseSize="200,200" />
        <MauiImage Include="Resources\Images\*" />
        <MauiFont Include="Resources\Fonts\*" />
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="Shiny.Hosting.Maui" />
        <PackageReference Include="Shiny.Maui.Shell" />
        <PackageReference Include="Shiny.BluetoothLE" />
        <PackageReference Include="Shiny.BluetoothLE.Hosting" />
        <PackageReference Include="Shiny.Maui.Controls" />
        <PackageReference Include="Shiny.Maui.Controls.Camera" />
        <PackageReference Include="Shiny.Audio" />
        <PackageReference Include="Shiny.Actors" />
        <PackageReference Include="Shiny.Notifications" />
        <PackageReference Include="Shiny.Net.HttpServer.Ssh" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Shiny.UniversalHubs.Host\Shiny.UniversalHubs.Host.csproj" />
        <ProjectReference Include="..\..\src\Shiny.UniversalHubs.Client\Shiny.UniversalHubs.Client.csproj" />
        <ProjectReference Include="..\..\src\Shiny.UniversalHubs.Multipeer\Shiny.UniversalHubs.Multipeer.csproj" />
        <!-- the hub proxies and dispatchers: a project reference doesn't carry the generator the way the package does -->
        <ProjectReference Include="..\..\src\Shiny.BluetoothLE.Hubs.SourceGenerators\Shiny.BluetoothLE.Hubs.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
