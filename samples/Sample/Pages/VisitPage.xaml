<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Sample.Pages"
             x:Class="Sample.Pages.VisitPage"
             x:DataType="local:VisitViewModel"
             Title="Message someone">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Text="{Binding Address}"
                   Placeholder="Address someone shared (https://...)"
                   Keyboard="Url"
                   ReturnCommand="{Binding ConnectToAddressCommand}" />
            <Button Grid.Column="1" Text="Go" Command="{Binding ConnectToAddressCommand}" />
        </Grid>

        <HorizontalStackLayout Grid.Row="1" Spacing="10">
            <ActivityIndicator IsRunning="True" HeightRequest="20" WidthRequest="20" />
            <Label Text="Nearby and on this network" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding People}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Nobody yet - anyone with the app open shows up here"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:HostItem">
                    <Border Margin="0,6" Padding="16" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding Reach}"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ConnectCommand, Source={RelativeSource AncestorType={x:Type local:VisitViewModel}}, x:DataType=local:VisitViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.RowSpan="3" IsVisible="{Binding IsConnecting}" BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="{Binding IsConnecting}" Color="White" />
        </Grid>
    </Grid>
</ContentPage>
