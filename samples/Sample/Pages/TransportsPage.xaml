<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Sample.Pages"
             x:Class="Sample.Pages.TransportsPage"
             x:DataType="local:TransportsViewModel"
             Title="Transports">

    <Grid RowDefinitions="Auto,*,Auto" Padding="12" RowSpacing="12">
        <Label Text="Host: what others reach this device's chat and games over. Client: what this device reaches others over. Solo runs one transport alone, both ways, so it can be tested on its own."
               FontSize="13" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding Transports}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:TransportRow">
                    <Border Padding="12" Margin="0,0,0,8" StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                            <Label Text="{Binding Title}" FontAttributes="Bold" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                                <Label Text="Host" FontSize="11" HorizontalOptions="Center" />
                                <Switch IsToggled="{Binding Hosting}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                                <Label Text="Client" FontSize="11" HorizontalOptions="Center" />
                                <Switch IsToggled="{Binding Connecting}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="3" Text="Solo" Command="{Binding SoloCommand}" VerticalOptions="Center" />
                            <Label Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding Status}" FontSize="12" TextColor="Gray" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" Text="Everything on" Command="{Binding AllCommand}" />
    </Grid>
</ContentPage>
