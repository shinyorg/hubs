<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Sample.Pages"
             xmlns:chat="clr-namespace:Shiny.Maui.Controls.Chat;assembly=Shiny.Maui.Controls"
             x:Class="Sample.Pages.ChatPage"
             x:DataType="local:ChatViewModel"
             Title="{Binding Conversation.Name}">

    <Grid RowDefinitions="Auto,*">
        <!-- who, how they're connected, and call buttons you can see -->
        <Grid ColumnDefinitions="*,Auto" Padding="16,8" ColumnSpacing="8">
            <Label Text="{Binding Conversation.Status}"
                   FontSize="12"
                   VerticalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                <Button Text="📞 Call" Command="{Binding CallCommand}" CommandParameter="{x:Boolean False}" Style="{StaticResource SecondaryButton}" />
                <Button Text="📹 Video" Command="{Binding CallCommand}" CommandParameter="{x:Boolean True}" Style="{StaticResource SecondaryButton}" />
            </HorizontalStackLayout>
        </Grid>

        <!-- photos: the attach button, tapped open in the image viewer. Files: "📎 Send a file" in the input menu -->
        <chat:ChatView x:Name="Chat"
                       Grid.Row="1"
                       OpenImagesInViewer="True"
                       MessageTapped="OnMessageTapped"
                       Provider="{Binding Provider}"
                       SessionId="{Binding SessionId}" />
    </Grid>
</ContentPage>
