<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Sample.Pages"
             xmlns:chat="clr-namespace:Shiny.Maui.Controls.Chat;assembly=Shiny.Maui.Controls"
             x:Class="Sample.Pages.ChatPage"
             x:DataType="local:ChatViewModel"
             Title="{Binding Conversation.Name}">

    <Grid RowDefinitions="Auto,*">
        <Label Text="{Binding Conversation.Status}"
               Padding="16,6"
               FontSize="12"
               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

        <chat:ChatView Grid.Row="1"
                       Provider="{Binding Provider}"
                       SessionId="{Binding SessionId}" />
    </Grid>
</ContentPage>
