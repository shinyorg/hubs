<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Sample.Pages"
             xmlns:services="clr-namespace:Sample.Services"
             x:Class="Sample.Pages.InboxPage"
             x:DataType="local:InboxViewModel"
             Title="Chat">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="12">
        <Label Text="{Binding OpenOn}"
               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

        <Border Grid.Row="1" Padding="14" StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="🌍 Share on the internet" FontAttributes="Bold" VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="{Binding IsSharing, Converter={StaticResource BoolToTextConverter}, ConverterParameter='Stop|Share'}"
                            Command="{Binding ToggleSharingCommand}"
                            Style="{StaticResource SecondaryButton}" />
                </Grid>
                <Label Text="{Binding ShareStatus}" FontSize="13" />
                <Label Text="{Binding PublicUrl}"
                       FontSize="13"
                       TextDecorations="Underline"
                       IsVisible="{Binding PublicUrl, Converter={StaticResource IsNotNullConverter}}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyUrlCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <ActivityIndicator IsRunning="{Binding IsStartingShare}" IsVisible="{Binding IsStartingShare}" />
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Chat.Conversations}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No messages yet. Anyone nearby can message you while the app is open."
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="services:Conversation">
                    <Border Margin="0,6" Padding="14" StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" />
                            <Label Grid.Column="1"
                                   Text="{Binding Unread}"
                                   IsVisible="{Binding Unread, Converter={StaticResource IsPositiveConverter}}"
                                   BackgroundColor="{StaticResource Primary}"
                                   TextColor="White"
                                   Padding="8,2" />
                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding LastText}" LineBreakMode="TailTruncation" />
                            <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Status}" FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </Grid>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type local:InboxViewModel}}, x:DataType=local:InboxViewModel}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="3" Text="Message someone" Command="{Binding VisitCommand}" />
    </Grid>
</ContentPage>
